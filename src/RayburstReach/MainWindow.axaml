<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RayburstReach.MainWindow"
        Title="Rayburst Avalonia — Download Manager"
        Width="1120" Height="780" MinWidth="850" MinHeight="620"
        Background="#11151D" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="5">
        <TextBlock Text="Rayburst Avalonia" FontSize="28" FontWeight="Bold" Foreground="#F4F7FB" />
        <TextBlock Text="Windows .NET port · powered by Aria2 Next" Foreground="#A7B1C2" FontSize="13" />
      </StackPanel>
      <Border Grid.Column="1" Background="#1B2230" BorderBrush="#30394A" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
        <TextBlock x:Name="EngineBadge" Text="ENGINE STARTING" Foreground="#48D9D0" FontSize="11" FontWeight="Bold" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="#1B2230" BorderBrush="#30394A" BorderThickness="1" CornerRadius="12" Padding="16">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Text="ADD DOWNLOADS" Foreground="#A7B1C2" FontSize="11" FontWeight="Bold" />
        <TextBox Grid.Row="1" x:Name="UrlBox" MinHeight="66" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="Paste one or more HTTP(S), FTP, magnet, ED2K or Thunder links — one per line" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Watermark="Download folder" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Browse…" Click="BrowseFolder_Click" />
            <Button Content="Add links" Click="Add_Click" Background="#48D9D0" Foreground="#11151D" FontWeight="Bold" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBlock Text="DOWNLOAD QUEUE" Foreground="#A7B1C2" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button Content="Pause" Click="Pause_Click" />
        <Button Content="Resume" Click="Resume_Click" />
        <Button Content="Remove" Click="Remove_Click" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Background="#151B25" BorderBrush="#30394A" BorderThickness="1" CornerRadius="12" Padding="12">
      <ListBox x:Name="DownloadList" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Items}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="#1B2230" BorderBrush="#30394A" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding FileName}" Foreground="#F4F7FB" FontSize="14" FontWeight="SemiBold" MaxWidth="620" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Status}" Foreground="#48D9D0" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TransferRate}" Foreground="#B8C6D8" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FilePath}" Foreground="#8492A7" FontSize="11" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="#A7B1C2" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="StatusLabel" Text="Starting local download engine…" Foreground="#A7B1C2" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="RPC bound to loopback · MIT app code" Foreground="#68768B" FontSize="11" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
