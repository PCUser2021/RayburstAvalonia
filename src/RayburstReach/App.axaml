<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             x:Class="RayburstReach.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <styling:FluentAvaloniaTheme UseSystemFontOnWindows="True" CustomAccentColor="#48D9D0" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#11151D" />
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1B2230" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#30394A" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#F4F7FB" />
      <SolidColorBrush x:Key="AppMutedBrush" Color="#A7B1C2" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#48D9D0" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
